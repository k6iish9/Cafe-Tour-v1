{
<div class="scene-cue" data-scene="choose" data-loop="1"></div>

<div class="stage">
  <div></div>
  <div class="caption">
    <div class="eyebrow">Tour complete</div>
    <h1 class="room-name">Ready to order?</h1>
  </div>
  <div class="cta">
    <span class="cta-link">(link-goto: "Order food", "Waiting In Line Scene")</span>
  </div>
</div>
}

:: Skip Tour {"position":"1050,600","size":"100,100"}
{
<!-- Tour first: skipping lands on ordering. Order first: skipping lands on the ending. -->
(if: $first is "tour")[(go-to: "Waiting In Line Scene")](else:)[(go-to: "Ending Scene")]
}

:: Ending Scene {"position":"550,1050","size":"100,100"}
{
<div class="scene-cue" data-scene="ending" data-loop="1"></div>

<div class="stage">
  <div></div>
  <div class="caption">
    <div class="eyebrow">Thank you</div>
    <h1 class="room-name">(print: $cafe)</h1>
    <p class="room-note">See you soon.</p>
  </div>
  <div class="cta">
    <span class="cta-link cta-link--quiet">(link-goto: "Watch again", "Opening Scene")</span>
  </div>
</div>
}

:: init [startup] {"position":"100,300","size":"100,100"}
<!--
  Runs once before the first passage.
  $cafe   the name shown on the Opening and Ending scenes
  $first  which stretch the viewer picked first: "" then "order" or "tour"
  $safety fallback timer. If a clip never reports it has ended, the story
          moves on after this long. Keep it longer than your longest clip.
-->
(set: $cafe to "Concordia’s Cafe")
(set: $first to "")
(set: $safety to 60s)

:: menu-bridge [header] {"position":"100,450","size":"100,100"}
<div class="jump-bridge" aria-hidden="true"><span class="here">(print: (passage:)'s name)</span>(link-goto: "Opening Scene", "Opening Scene")(link-goto: "Choose Route", "Choose Route")(link-goto: "Waiting In Line Scene", "Waiting In Line Scene")(link-goto: "Food Menu Scene", "Food Menu Scene")(link-goto: "Order Done Scene", "Order Done Scene")(link-goto: "Balcony Area Scene", "Balcony Area Scene")(link-goto: "2FL Area Scene", "2FL Area Scene")(link-goto: "GFL Area 1 Scene", "GFL Area 1 Scene")(link-goto: "GFL Area 2 Scene", "GFL Area 2 Scene")(link-goto: "Ending Scene", "Ending Scene")</div>
