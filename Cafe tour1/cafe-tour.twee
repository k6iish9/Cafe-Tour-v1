:: Food Menu Scene {"position":"250,600","size":"100,100"}
{
(if: $first is "")[(set: $first to "order")]
<div class="scene-cue" data-scene="menu" data-loop="1" data-loop-from="9" data-reveal="10.5"></div>

<div class="stage">
  <div class="menu-instruction reveal-late"><span class="t-click">Click a page edge to turn it. Click a page to zoom.</span><span class="t-tap">Tap a page edge to turn it. Tap a page to zoom.</span></div>

  <div class="menu-book reveal-late" data-spread="0">
    <div class="mb-stage">
      <div class="pg pg-l pg-1"><div class="pg-sec">Drinks</div><div class="pg-num">Page 1</div><div class="pg-file">menu/page-1.jpg</div></div>
      <div class="pg pg-r pg-4"><div class="pg-sec">Food</div><div class="pg-num">Page 4</div><div class="pg-file">menu/page-4.jpg</div></div>
      <div class="leaf">
        <div class="face face-front"><div class="pg pg-r pg-2"><div class="pg-sec">Drinks</div><div class="pg-num">Page 2</div><div class="pg-file">menu/page-2.jpg</div></div></div>
        <div class="face face-back"><div class="pg pg-l pg-3"><div class="pg-sec">Food</div><div class="pg-num">Page 3</div><div class="pg-file">menu/page-3.jpg</div></div></div>
      </div>
    </div>
    <div class="mb-edge mb-edge--prev" data-turn="prev" role="button" tabindex="0" aria-label="Previous page"></div>
    <div class="mb-edge mb-edge--next" data-turn="next" role="button" tabindex="0" aria-label="Next page"></div>
  </div>
  <div class="menu-veil"></div>
  <div class="mb-nav mb-nav--prev" data-turn="prev"></div>
  <div class="mb-nav mb-nav--next" data-turn="next"></div>

  <div></div>
  <div class="caption">
    <div class="steps"><i class="on"></i><i class="on"></i><i></i></div>
    <div class="eyebrow">Order</div>
    <div class="title-swap">
      <h1 class="room-name hide-late">Ordering food</h1>
      <h1 class="room-name reveal-late">The menu</h1>
    </div>
  </div>
  <div class="cta reveal-late">
    <span class="cta-link cta-link--quiet">(link-goto: "Continue", "Order Done Scene")</span>
  </div>
</div>
}

